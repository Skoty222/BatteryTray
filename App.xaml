<Application x:Class="BatteryTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Defaults (light). ThemeService swaps these at runtime. -->
        <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Text" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="SubText" Color="#5F5F5F"/>
        <SolidColorBrush x:Key="Border" Color="#E0E0E0"/>
    </Application.Resources>
</Application>
