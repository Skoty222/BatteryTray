<Window x:Class="BatteryTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Tray" Width="520" Height="620" MinWidth="420" MinHeight="300"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Padding="12,4" Margin="0,0,8,0" Click="OnRefresh"/>
                <Button Content="Settings" Padding="12,4" Click="OnSettings"/>
            </StackPanel>
            <TextBlock Text="Wireless devices" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="28" Foreground="{DynamicResource Text}"
                                               VerticalAlignment="Top" Margin="0,2,14,0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubTitle}" Foreground="{DynamicResource SubText}"
                                                   Visibility="{Binding SubTitleVisibility}"/>
                                        <ProgressBar Value="{Binding BarValue}" Maximum="100" Height="6" Margin="0,8,0,0"
                                                     Foreground="{Binding BarBrush}" Visibility="{Binding BarVisibility}"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubText}"
                                                   TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                                   Visibility="{Binding DetailVisibility}"/>
                                        <Viewbox Height="28" Stretch="Fill" Margin="0,8,0,0"
                                                 Visibility="{Binding SparkVisibility}" ToolTip="Battery level, last 24 hours">
                                            <Canvas Width="300" Height="28">
                                                <Polyline Points="{Binding Spark}" Stroke="{DynamicResource SubText}" StrokeThickness="1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Button Content="Set manually..." Tag="{Binding Key}" Click="OnManual"
                                                HorizontalAlignment="Left" Padding="10,3" Margin="0,8,0,0"
                                                Visibility="{Binding ManualVisibility}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="{Binding PercentFontSize}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                               VerticalAlignment="Top" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"
                           Text="No devices found yet. Pair a Bluetooth device, plug in a receiver, or check Settings > Devices."
                           Visibility="Collapsed" Margin="4,8"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" FontSize="12"
                   Foreground="{DynamicResource SubText}"/>
    </Grid>
</Window>
